# OpenRouter — powers EVERYTHING: chatbot + vector embeddings (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Chat model — any OpenRouter model slug. Browse models at https://openrouter.ai/models
# Examples: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini
# Embedding model — used for book recommendations / topic & educational filtering.
# Defaults to a FREE OpenRouter embedding model. Browse: https://openrouter.ai/models
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# Optional: override the chatbot's system prompt / persona
# OPENROUTER_SYSTEM_PROMPT=
# Optional: app attribution for OpenRouter rankings/analytics
# OPENROUTER_SITE_URL=https://your-site.com
# OPENROUTER_SITE_NAME=TMAS AI

# Supabase — PDF storage (set on Cloudflare Worker + Build env)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SUPABASE_PDF_BUCKET=pdfs
# Optional server alias (used by /api/pdf-url at runtime)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Only for local upload script (scripts/upload-pdfs.mjs) — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=
